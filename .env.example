# =============================================================================
# ResearchMind AI — Environment Configuration
# =============================================================================
# Copy this file to `.env` in the project root and fill in the values marked
# REQUIRED. Everything else has a safe default and only needs to be touched
# if you want to change behavior.
#
# Nesting convention: settings are grouped (see backend/app/core/config.py)
# and env vars use a double underscore "__" as the nesting delimiter, e.g.
# LLM__OLLAMA__BASE_URL maps to Settings.llm.ollama.base_url.
#
# Booleans accept: true/false, 1/0, yes/no (case-insensitive).
# Lists (CORS origins, upload extensions) accept comma-separated values.
# =============================================================================


# -----------------------------------------------------------------------------
# APP — general application & HTTP server metadata
# -----------------------------------------------------------------------------
APP__NAME=ResearchMind AI
APP__VERSION=0.1.0
# One of: local, development, staging, production
APP__ENVIRONMENT=local
APP__DEBUG=true

APP__API_HOST=0.0.0.0
APP__API_PORT=8000
APP__API_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins (Streamlit dev server, etc.)
APP__CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501


# -----------------------------------------------------------------------------
# LLM — provider-agnostic settings + one block per concrete provider
# -----------------------------------------------------------------------------
# Selects which concrete LLMService implementation is constructed by
# core.dependencies.get_llm_service(). Business logic never reads this
# directly — it only depends on the LLMService interface.
# One of: ollama, openai, anthropic, azure_openai
LLM__PROVIDER=ollama

LLM__MAX_RETRIES=3
LLM__TIMEOUT_SECONDS=60
LLM__MAX_CONTEXT_TOKENS=8192

# --- Ollama (default/local provider) ---
# Use http://ollama:11434 instead when running via docker-compose, since the
# backend container reaches Ollama by its service name, not localhost.
LLM__OLLAMA__BASE_URL=http://localhost:11434
LLM__OLLAMA__MODEL=qwen3
LLM__OLLAMA__TEMPERATURE=0.3
LLM__OLLAMA__KEEP_ALIVE=5m

# --- OpenAI (optional future provider; REQUIRED only if LLM__PROVIDER=openai) ---
# LLM__OPENAI__API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM__OPENAI__MODEL=gpt-4o-mini
# LLM__OPENAI__ORGANIZATION=
# LLM__OPENAI__BASE_URL=

# --- Anthropic (optional future provider; REQUIRED only if LLM__PROVIDER=anthropic) ---
# LLM__ANTHROPIC__API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM__ANTHROPIC__MODEL=claude-sonnet-4-5

# --- Azure OpenAI (optional future provider; REQUIRED only if LLM__PROVIDER=azure_openai) ---
# LLM__AZURE_OPENAI__API_KEY=
# LLM__AZURE_OPENAI__ENDPOINT=https://your-resource.openai.azure.com/
# LLM__AZURE_OPENAI__DEPLOYMENT_NAME=
LLM__AZURE_OPENAI__API_VERSION=2024-08-01-preview


# -----------------------------------------------------------------------------
# EMBEDDING — Sentence Transformers configuration for the RAG pipeline
# -----------------------------------------------------------------------------
EMBEDDING__MODEL_NAME=all-MiniLM-L6-v2
# One of: cpu, cuda
EMBEDDING__DEVICE=cpu
EMBEDDING__BATCH_SIZE=32
EMBEDDING__NORMALIZE_EMBEDDINGS=true


# -----------------------------------------------------------------------------
# VECTOR_STORE — ChromaDB configuration
# -----------------------------------------------------------------------------
# One of: chroma
VECTOR_STORE__PROVIDER=chroma
VECTOR_STORE__PERSIST_DIR=./data/chroma
VECTOR_STORE__COLLECTION_NAME=researchmind_documents
VECTOR_STORE__DISTANCE_METRIC=cosine
# Disable Chroma's anonymized telemetry ping on startup
VECTOR_STORE__TELEMETRY_ENABLED=false


# -----------------------------------------------------------------------------
# SEARCH — Tavily web search configuration (behind the SearchProvider interface)
# -----------------------------------------------------------------------------
# One of: tavily
SEARCH__PROVIDER=tavily
# REQUIRED in staging/production if FEATURES__ENABLE_WEB_SEARCH=true.
# Get a key at https://tavily.com
# SEARCH__TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
SEARCH__MAX_RESULTS=5
SEARCH__MAX_RETRIES=3


# -----------------------------------------------------------------------------
# DATABASE — SQLite by default; swap the URL to Postgres later with no
# code changes (repository pattern isolates persistence from services).
# -----------------------------------------------------------------------------
DATABASE__URL=sqlite+aiosqlite:///./data/researchmind.db
DATABASE__ECHO=false
DATABASE__POOL_PRE_PING=true


# -----------------------------------------------------------------------------
# LOGGING — structured JSON logging
# -----------------------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING__LEVEL=INFO
# One of: json, console  (use "console" for readable local dev output)
LOGGING__FORMAT=console
LOGGING__INCLUDE_TRACE_ID=true
LOGGING__INCLUDE_REQUEST_ID=true


# -----------------------------------------------------------------------------
# RAG — document ingestion & retrieval pipeline
# -----------------------------------------------------------------------------
RAG__CHUNK_SIZE=1000
RAG__CHUNK_OVERLAP=200
RAG__RETRIEVAL_TOP_K=5
RAG__RETRIEVAL_SCORE_THRESHOLD=0.3
RAG__MAX_UPLOAD_SIZE_MB=25
RAG__ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md
RAG__MAX_DOCUMENTS_PER_SESSION=20
RAG__MAX_UPLOAD_FILES=10


# -----------------------------------------------------------------------------
# AGENT — LangGraph multi-agent workflow behavior
# -----------------------------------------------------------------------------
# Hard cap on the Reviewer -> Writer revision loop to prevent infinite cycles
AGENT__MAX_REVIEWER_RETRIES=2
AGENT__AGENT_TIMEOUT_SECONDS=120
AGENT__MAX_CHAT_HISTORY=20


# -----------------------------------------------------------------------------
# REPORT — report generation & export
# -----------------------------------------------------------------------------
REPORT__OUTPUT_DIR=./reports
# One of: markdown, pdf
REPORT__DEFAULT_EXPORT_FORMAT=markdown


# -----------------------------------------------------------------------------
# FEATURES — runtime feature flags (degrade gracefully instead of failing)
# -----------------------------------------------------------------------------
FEATURES__ENABLE_WEB_SEARCH=true
FEATURES__ENABLE_RAG=true
FEATURES__ENABLE_MEMORY=true
FEATURES__ENABLE_REPORT_EXPORT=true
FEATURES__ENABLE_AGENT_TRACING=true


# -----------------------------------------------------------------------------
# CACHE — optional on-disk caching (e.g. embeddings, search results)
# -----------------------------------------------------------------------------
CACHE__ENABLED=false
CACHE__DIR=./data/cache
CACHE__TTL_SECONDS=3600


# -----------------------------------------------------------------------------
# HTTP — default outbound HTTP client behavior
# -----------------------------------------------------------------------------
HTTP__TIMEOUT_SECONDS=30
